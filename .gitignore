# Claude temp files
.claude/

# Playwright screenshots
.playwright-mcp/

# Ad-hoc test/verification screenshots at repo root (screenshot-*, test-*,
# verify-*, uat-*, diag-*, etc). Real app assets live in songbook_app/assets/
# and are unaffected by this root-only pattern.
/*.png

# Windows artifact from a stray `> nul` redirect
/nul

# Python caches (import/OCR tooling)
__pycache__/
*.pyc

# Supabase CLI is pinned as a devDependency in the root package.json, so the
# repo controls its version. Only the tool lives here — no app JS.
node_modules/

# Local Supabase secrets. supabase/config.toml and supabase/migrations/ ARE
# tracked; the linked-project ref and any .env are not.
supabase/.temp/
supabase/.branches/
.env
.env.local

# Database dumps. NEVER commit these -- this repo is public and
# `supabase db dump --data-only` includes the whole `auth` schema:
# auth.users (email, encrypted_password, confirmation_token, recovery_token)
# plus auth.sessions and auth.refresh_tokens. Treat every file here as a secret.
backups/
*.dump
*.backup

# Build outputs
songbook_app/build/
songbook_app/.dart_tool/

# Audiveris temp outputs
tools/audiveris_output/*.omr
tools/audiveris_output/*.log

# OS files
.DS_Store
Thumbs.db

# Photo-import worker API key — never commit.
tools/.anthropic_key

# Photos kept by `photo_import_worker.py --save-dir` while debugging a reading.
tools/photo_debug/

# Pages generated by tools/fixtures/build.py — regenerate, do not commit.
tools/fixtures/out/

# Song photos dropped in for debugging a reading.
tools/photo_inbox/*
!tools/photo_inbox/README.txt

# The measurement corpus: photographs of a copyrighted hymnal. This repo is
# public, so the images stay on the machine that took them. What travels
# instead is everything derived from them — manifest.json says what each page
# stresses, checksums.txt pins the exact bytes, and tools/fixtures/gold/ holds
# the hand-verified answer each one is scored against. Same treatment
# deploy/omr/app/ gets, and for the same reason: not ours to redistribute.
tools/fixtures/photos/*
!tools/fixtures/photos/manifest.json
!tools/fixtures/photos/checksums.txt
!tools/fixtures/photos/README.md

# One measurement run, with every stage record for every page. Regenerate it
# with `python -m tools.ocr_harness run`; what travels is the accepted
# baseline in tools/ocr_harness/baseline.json.
tools/fixtures/runs/

# Session handoffs: written to be read once by the next session and replaced,
# not reviewed as history. HANDOFF-photo-import.md is deliberately tracked and
# stays so — a rule here cannot untrack what is already tracked.
HANDOFF*.md

# The gold-review page, rebuilt from the gold files on demand.
tools/fixtures/review.html

# Compiled harness + staged photographs for the browser engine. Rebuilt on
# demand by tools/ocr_harness/browser.py.
tools/fixtures/browser/
