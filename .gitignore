# Claude temp files
.claude/

# Playwright screenshots
.playwright-mcp/

# Ad-hoc test/verification screenshots at repo root (screenshot-*, test-*,
# verify-*, uat-*, diag-*, etc). Real app assets live in songbook_app/assets/
# and are unaffected by this root-only pattern.
/*.png

# Windows artifact from a stray `> nul` redirect
/nul

# Python caches (import/OCR tooling)
__pycache__/
*.pyc

# Supabase CLI is pinned as a devDependency in the root package.json, so the
# repo controls its version. Only the tool lives here — no app JS.
node_modules/

# Local Supabase secrets. supabase/config.toml and supabase/migrations/ ARE
# tracked; the linked-project ref and any .env are not.
supabase/.temp/
supabase/.branches/
.env
.env.local

# Database dumps. NEVER commit these -- this repo is public and
# `supabase db dump --data-only` includes the whole `auth` schema:
# auth.users (email, encrypted_password, confirmation_token, recovery_token)
# plus auth.sessions and auth.refresh_tokens. Treat every file here as a secret.
backups/
*.dump
*.backup

# Build outputs
songbook_app/build/
songbook_app/.dart_tool/

# Audiveris temp outputs
tools/audiveris_output/*.omr
tools/audiveris_output/*.log

# OS files
.DS_Store
Thumbs.db

# Photo-import worker API key — never commit.
tools/.anthropic_key

# Photos kept by `photo_import_worker.py --save-dir` while debugging a reading.
tools/photo_debug/

# Pages generated by tools/fixtures/build.py — regenerate, do not commit.
tools/fixtures/out/

# Song photos dropped in for debugging a reading.
tools/photo_inbox/*
!tools/photo_inbox/README.txt
