        "year": 1743
      }
    },
    "originalKey": "G",
    "timeSignature": "4/4",
    "verses": [
      {
        "number": 1,
        "hasNotation": true,
        "lines": [
          {
            "text": "Ó, jöjjetek, hívek,",
            "chords": [
              {
                "chord": "G",
                "position": 0
              },
              {
                "chord": "D",
                "position": 8
              },
              {
                "chord": "G",
                "position": 14
              }
            ]
          },
          {
            "text": "jöjjetek vidáman,",
            "chords": [
              {
                "chord": "C",
                "position": 0
              },
              {
                "chord": "G",
                "position": 8
              }
            ]
          },
          {
            "text": "Ó, jöjjetek, jöjjetek",
            "chords": [
              {
                "chord": "D",
                "position": 0
              },
              {
                "chord": "G",
                "position": 9
              },
              {
                "chord": "A",
                "position": 14
              },
              {
                "chord": "D",
                "position": 18
              }
            ]
          },
          {
            "text": "Betlehembe!",
            "chords": [
              {
                "chord": "G",
                "position": 0
              },
              {
                "chord": "D",
                "position": 6
              },
              {
                "chord": "G",
                "position": 10
              }
            ]
          }
        ]
      },
      {
        "number": 2,
        "hasNotation": false,
        "plainText": "Lássátok a Messiást, Ki most született, Jöjjetek, imádjuk, jöjjetek, imádjuk, Jöjjetek, imádjuk a Királyt!"
      },
      {
        "number": 3,
        "hasNotation": false,
        "plainText": "Angyalok éneklik a magas mennyekben: Dicsőség, dicsőség Istennek! Jöjjetek, imádjuk, jöjjetek, imádjuk, Jöjjetek, imádjuk a Királyt!"
      }
    ],
    "tags": [
      "karácsony",
      "advent",
      "imádás"
    ]
  },
  {
    "number": 350,
    "title": "Uram, te hozzád kiáltok",
    "reference": "Zsolt 141",
    "origin": {
      "place": "Geneva",
      "year": 1562
    },
    "tune": {
      "name": "Genfi zsoltárdallam",
      "origin": {
        "place": "Geneva",
        "year": 1562
      }
    },
    "originalKey": "Am",
    "timeSignature": "4/4",
    "verses": [
      {
        "number": 1,
        "hasNotation": true,
        "lines": [
          {
            "text": "Uram, te hozzád kiáltok,",
            "chords": [
              {
                "chord": "Am",
                "position": 0
              },
              {
                "chord": "E",
                "position": 10
              },
              {
                "chord": "Am",
                "position": 18
              }
            ]
          },
          {
            "text": "Siess, hallgass meg engemet!",
            "chords": [
              {
                "chord": "Dm",
                "position": 0
              },
              {
                "chord": "Am",
                "position": 8
              },
              {
                "chord": "E",
                "position": 17
              }
            ]
          },
          {
            "text": "Fogadd el az én imádságom,",
            "chords": [
              {
                "chord": "Am",
                "position": 0
              },
              {
                "chord": "G",
                "position": 12
              },
              {
                "chord": "C",
                "position": 22
              }
            ]
          },
          {
            "text": "Mint füstölő áldozatot.",
            "chords": [
              {
                "chord": "F",
                "position": 0
              },
              {
                "chord": "E",
                "position": 10
              },
              {
                "chord": "Am",
                "position": 18
              }
            ]
          }
        ]
      },
      {
        "number": 2,
        "hasNotation": false,
        "plainText": "Tégy, Uram, őrizetet számra, És őrizd meg ajkam kapuját, Hogy gonoszra ne hajoljon szívem, És rossz útra ne térjen el."
      }
    ],
