    "verses": [
      {
        "number": 1,
        "hasNotation": true,
        "lines": [
          {
            "text": "Hatalmas Isten, nagy haragodban",
            "chords": [
              {
                "chord": "Bb",
                "position": 0
              }
            ]
          },
          {
            "text": "ne feddj meg engemet,",
            "chords": [
              {
                "chord": "Bb",
                "position": 0
              }
            ]
          },
          {
            "text": "Te haragodnak nagysága miatt",
            "chords": [
              {
                "chord": "Bb",
                "position": 0
              }
            ]
          },
          {
            "text": "ne ostorozz engem,",
            "chords": [
              {
                "chord": "Bb",
                "position": 0
              }
            ]
          },
          {
            "text": "Mert haragodnak nagy volta miatt",
            "chords": [
              {
                "chord": "Bb",
                "position": 0
              }
            ]
          },
          {
            "text": "el kellene vesznem.",
            "chords": [
              {
                "chord": "Bb",
                "position": 0
              }
            ]
          }
        ]
      },
      {
        "number": 2,
        "hasNotation": false,
        "plainText": "Mégis, Úr Isten, könyörülj rajtam, mert én gyenge vagyok, Tudod, Úr Isten, beteg voltomat, mert bűneim nagyok, Gyógyíts meg engem e fájdalomból, mert gyógyulást várok."
      },
      {
        "number": 3,
        "hasNotation": false,
        "plainText": "Az én lelkem is igen megrettenve, Uram, meddig késel? Térj hozzám, Uram, mentsd meg lelkemet, És kegyelmeddel segélj!"
      }
    ],
    "tags": [
      "zsoltár",
      "bűnbánat",
      "könyörgés"
    ]
  },
  {
    "number": 200,
    "title": "Jöjj, mondjunk hálaszót",
    "reference": null,
    "origin": {
      "place": "Magyarország",
      "year": 1806
    },
    "tune": {
      "name": "Nun danket alle Gott",
      "origin": {
        "place": "Németország",
        "year": 1647
      }
    },
    "originalKey": "Eb",
    "timeSignature": "4/4",
    "verses": [
      {
        "number": 1,
        "hasNotation": true,
        "lines": [
          {
            "text": "Jöjj, mondjunk hálaszót,",
            "chords": [
              {
                "chord": "Eb",
                "position": 0
              },
              {
                "chord": "Ab",
                "position": 8
              },
              {
                "chord": "Eb",
                "position": 16
              }
            ]
          },
          {
            "text": "áldjuk az Istent,",
            "chords": [
              {
                "chord": "Bb",
                "position": 0
              },
              {
                "chord": "Eb",
                "position": 8
              }
            ]
          },
          {
            "text": "Ki velünk ennyi jót",
            "chords": [
              {
                "chord": "Ab",
                "position": 0
              },
              {
                "chord": "Eb",
                "position": 7
              },
              {
                "chord": "Bb",
                "position": 13
              }
            ]
          },
          {
            "text": "tett szünetlenül.",
            "chords": [
              {
                "chord": "Eb",
                "position": 0
              },
              {
                "chord": "Bb",
                "position": 7
              },
              {
                "chord": "Eb",
                "position": 13
              }
            ]
          }
        ]
      },
      {
        "number": 2,
        "hasNotation": false,
        "plainText": "Ki anyánk méhétől fogva Megőriz szüntelen, S életünket minden bajban Oltalmazza kegyesen."
      },
      {
        "number": 3,
        "hasNotation": false,
        "plainText": "Dicsőség az Atyának, S egyszülött Fiának, A Szentlélekkel együtt, Most és mindörökké. Ámen."
      }
    ],
    "tags": [
      "hálaadás",
      "dicséret"
    ]
  },
  {
    "number": 256,
    "title": "Erős vár a mi Istenünk",
    "reference": "Zsolt 46",
    "origin": {
      "place": "Németország",
      "year": 1529
    },
    "tune": {
      "name": "Ein feste Burg",
      "origin": {
        "place": "Németország",
        "year": 1529
      }
    },
    "originalKey": "C",
    "timeSignature": "4/4",
    "verses": [
      {
        "number": 1,
        "hasNotation": true,
        "lines": [
          {
            "text": "Erős vár a mi Istenünk,",
            "chords": [
              {
                "chord": "C",
                "position": 0
              },
              {
                "chord": "G",
                "position": 10
              },
              {
                "chord": "Am",
                "position": 16
              },
              {
                "chord": "C",
                "position": 22
              }
            ]
          },
          {
            "text": "Jó fegyverünk és pajzsunk.",
            "chords": [
              {
                "chord": "F",
                "position": 0
              },
              {
                "chord": "C",
                "position": 8
              },
              {
                "chord": "G",
                "position": 16
              },
              {
                "chord": "C",
                "position": 22
              }
            ]
          },
          {
            "text": "Ha ő velünk, ki ellenünk?",
            "chords": [
              {
                "chord": "Am",
                "position": 0
              },
              {
                "chord": "Em",
                "position": 10
              },
              {
                "chord": "F",
                "position": 16
              },
              {
                "chord": "C",
                "position": 22
              }
            ]
          },
          {
            "text": "Az Úr a mi oltalmunk!",
            "chords": [
              {
                "chord": "G",
                "position": 0
              },
              {
                "chord": "Am",
                "position": 6
              },
              {
                "chord": "F",
                "position": 12
              },
              {
                "chord": "G",
                "position": 16
              },
              {
                "chord": "C",
                "position": 20
              }
            ]
          }
        ]
      },
      {
        "number": 2,
        "hasNotation": false,
        "plainText": "Ha e világ mind ördög volna, Elnyelni kész, de ne félj! A Krisztus harcol mellettünk, S győz a hittel, ki felveszi."
      },
      {
        "number": 3,
        "hasNotation": false,
        "plainText": "Az ige áll az erős Isten, Nincs más segítség nekünk. Hadd vesszen el kincs, test és vér, Országunk megmarad."
      }
    ],
    "tags": [
      "reformáció",
      "bizalom",
      "Luther"
    ]
  },
  {
    "number": 300,
    "title": "Ó, jöjjetek, hívek",
    "reference": null,
    "origin": {
      "place": "Portugália",
      "year": 1743
    },
    "tune": {
      "name": "Adeste fideles",
      "origin": {
