[
  {
    "number": 1,
    "title": "Szent Isten, kit a seregek",
    "reference": "Zsolt 89",
    "origin": {
      "place": "Geneva",
      "year": 1562
    },
    "tune": {
      "name": "Genfi zsoltárdallam",
      "origin": {
        "place": "Geneva",
        "year": 1551
      }
    },
    "originalKey": "G",
    "timeSignature": "4/4",
    "verses": [
      {
        "number": 1,
        "hasNotation": true,
        "lines": [
          {
            "text": "Szent Isten, kit a seregek",
            "chords": [
              {
                "chord": "G",
                "position": 0
              },
              {
                "chord": "D",
                "position": 14
              },
              {
                "chord": "G",
                "position": 22
              }
            ]
          },
          {
            "text": "tisztelnek, dicsőítenek,",
            "chords": [
              {
                "chord": "C",
                "position": 0
              },
              {
                "chord": "G",
                "position": 11
              },
              {
                "chord": "D",
                "position": 22
              }
            ]
          },
          {
            "text": "Ki vagy, ki voltál, ki leszel,",
            "chords": [
              {
                "chord": "G",
                "position": 0
              },
              {
                "chord": "Em",
                "position": 9
              },
              {
                "chord": "C",
                "position": 18
              }
            ]
          },
          {
            "text": "örökkön élő szent felség.",
            "chords": [
              {
                "chord": "G",
                "position": 0
              },
              {
                "chord": "D",
                "position": 10
              },
              {
                "chord": "G",
                "position": 18
              }
            ]
          }
        ]
      },
      {
        "number": 2,
        "hasNotation": false,
        "plainText": "Téged dicsér a föld s az ég, Mert te vagy az erős vitéz, Hatalmadnak nincs vége, Uradnak és felségednek."
      },
      {
        "number": 3,
        "hasNotation": false,
        "plainText": "Add, hogy mi is téged dicsérjünk, És szent nevednek énekeljünk, Míg élünk itt e földön, S majd ott fenn az örök mennyben."
      }
    ],
    "tags": [
      "zsoltár",
      "dicsőítés",
      "imádás"
    ]
  },
  {
    "number": 42,
    "title": "Mint a szép híves patakra",
