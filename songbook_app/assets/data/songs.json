    "verses": [
      {
        "number": 1,
        "hasNotation": true,
        "lines": [
          {
            "text": "Tebenned bíztunk eleitől fogva,",
            "chords": [
              {
                "chord": "Bb",
                "position": 0
              }
            ]
          },
          {
            "text": "Uram, téged tartottunk hajlékunknak!",
            "chords": [
              {
                "chord": "Bb",
                "position": 0
              }
            ]
          },
          {
            "text": "Mikor még semmi hegyek nem voltanak,",
            "chords": [
              {
                "chord": "Bb",
                "position": 0
              }
            ]
          },
          {
            "text": "Hogy még sem ég, sem föld nem volt formálva,",
            "chords": [
              {
                "chord": "Bb",
                "position": 0
              }
            ]
          },
          {
            "text": "Te voltál, és te vagy, erős Isten,",
            "chords": [
              {
                "chord": "Bb",
                "position": 0
              }
            ]
          },
          {
            "text": "És te megmaradsz minden időben.",
            "chords": [
              {
                "chord": "Bb",
                "position": 0
              }
            ]
          }
        ]
      },
      {
        "number": 2,
        "hasNotation": false,
        "plainText": "Ezer esztendő előtted csak annyi, mint a tegnapi nap mely elmúlt már régen, Vagy az éjnek rövid őrállása, mely nem tart soká semmiben."
      },
      {
        "number": 3,
        "hasNotation": false,
        "plainText": "Azért Uram, taníts meg minket, hogy napjainkat számláljuk, És szívünkben bölcsességre, általad juthassunk el."
      }
    ],
    "tags": [
      "zsoltár",
      "örökkévalóság",
      "bizalom"
    ]
  },
