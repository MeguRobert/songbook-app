              {
                "chord": "G",
                "position": 0
              },
              {
                "chord": "D",
                "position": 9
              },
              {
                "chord": "A",
                "position": 16
              }
            ]
          },
          {
            "text": "Lelkem úgy óhajt Uramra,",
            "chords": [
              {
                "chord": "D",
                "position": 0
              },
              {
                "chord": "Bm",
                "position": 7
              },
              {
                "chord": "A",
                "position": 17
              }
            ]
          },
          {
            "text": "és hozzá fohászkodik.",
            "chords": [
              {
                "chord": "G",
                "position": 0
              },
              {
                "chord": "D",
                "position": 8
              },
              {
                "chord": "A",
                "position": 14
              },
              {
                "chord": "D",
                "position": 18
              }
            ]
          }
        ]
      },
      {
        "number": 2,
        "hasNotation": false,
        "plainText": "Tehozzád, élő Istenhez, szomjúhozik én lelkem, Vajon mikor jutok szemedbe, s előtted megjelenhetek?"
      }
    ],
